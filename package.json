{
  "name": "culturando",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "audit": "node scripts/audit.mjs",
    "validate": "node scripts/validate.mjs",
    "prebuild": "npm run validate",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "novo-evento": "node scripts/novo-evento.mjs",
    "test": "node --test --test-isolation=none scripts/content.test.mjs scripts/audit.test.mjs scripts/map.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "markdown-it": "^15.0.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
